<main class="min-h-screen flex flex-col items-center justify-center gap-9 px-6 py-12 text-center">
  <BurrowWeb.Layouts.mark size={88} label="Peon" />
  <h1 class="m-0 text-[clamp(64px,11vw,152px)] leading-[0.95] font-bold tracking-[-0.045em]">
    Work work.
  </h1>
  <div class="flex gap-5 items-center flex-wrap justify-center">
    <.link
      :if={Burrow.Accounts.sign_ups?()}
      navigate={~p"/users/register"}
      class="btn btn-primary btn-lg"
    >
      Create account
    </.link>
    <.link
      navigate={~p"/users/log-in"}
      class={["btn btn-lg", if(Burrow.Accounts.sign_ups?(), do: "btn-ghost", else: "btn-primary")]}
    >
      Log in
    </.link>
  </div>
</main>
