# {{ ansible_managed }}
MIX_ENV="prod"
PHX_SERVER="true"
HOME="{{ burrow_home }}"
LANG="C.UTF-8"
PORT="{{ burrow_port }}"
PHX_HOST="{{ burrow_domain }}"
BURROW_PUBLIC_URL="https://{{ burrow_domain }}"
BURROW_PORT_URL="https://peon-{port}.{{ burrow_domain }}"
DATABASE_PATH="{{ burrow_database }}"
BURROW_DATA_DIR="{{ burrow_data_dir }}"
BURROW_SANDBOX_IMAGE="{{ sandbox_image }}"
BURROW_OPENCODE_BIN="/usr/local/bin/opencode"
BURROW_SIGN_UPS="{{ burrow_sign_ups }}"
BURROW_MAX_HOST_CHATS="{{ burrow_max_host_chats }}"
BURROW_MAIL_FROM="{{ burrow_mail_from }}"
RESEND_API_KEY="{{ vault_resend_api_key }}"
