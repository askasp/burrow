# {{ ansible_managed }}
[Unit]
Description=Burrow's Cloudflare tunnel ({{ burrow_domain }}, *.{{ burrow_domain }})
After=network-online.target burrow-router.service
Wants=network-online.target burrow-router.service

[Service]
Type=exec
User={{ burrow_user }}
Group={{ burrow_user }}
Environment=HOME={{ burrow_home }}
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --config /etc/burrow/tunnel.yml run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
